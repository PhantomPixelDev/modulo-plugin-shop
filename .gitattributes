* text=auto eol=lf
# Kept out of the release package: the core's archive extractor accepts only
# files a plugin actually needs.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
# Build tooling for resources/dist/plugin.js
/package.json export-ignore
/package-lock.json export-ignore
/vite.config.js export-ignore
/tsconfig.json export-ignore
# Tests run in CI against Modulo core; they are not part of the plugin
/tests export-ignore
# Sources of resources/dist; the package ships the built files
/resources/js export-ignore
/resources/css export-ignore
